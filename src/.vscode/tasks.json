{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format JSON (Custom)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/pretty-format-json.js",
        "${file}"
      ],
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
        "label": "Cup Wizard",
        "type": "shell",
        "command": "powershell.exe",
        "args": [
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "${workspaceFolder}/scripts/cupwizard.ps1",
            "${input:cupName}",
            "${input:leagues}"
        ],
        "problemMatcher": []
    }
  ],
  "inputs": [
      {
          "id": "cupName",
          "type": "promptString",
          "description": "Cup name",
          "default": ""
      },
      {
          "id": "leagues",
          "type": "promptString",
          "description": "Leagues (comma-separated)",
          "default": "1500,2500,10000"
      }
  ]
}
